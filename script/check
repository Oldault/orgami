#!/usr/bin/env bash
# Everything CI runs, runnable before you push. No arguments: both passes.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

# completions/orgami.zsh is not here on purpose: bash -n and shellcheck do not
# read zsh. test/completions_test.sh runs `zsh -n` over it instead.
SCRIPTS=(bin/orgami install.sh script/check completions/orgami.bash)
while IFS= read -r f; do SCRIPTS+=("$f"); done < <(
  find lib hooks test -name '*.sh' -type f | sort
)

syntax() {
  local f bad=0
  for f in "${SCRIPTS[@]}"; do
    bash -n "$f" || { echo "syntax error: $f" >&2; bad=1; }
  done
  [[ $bad == 0 ]] && echo "bash -n: ${#SCRIPTS[@]} scripts ok"
  return $bad
}

# One file at a time, and without --external-sources: every lib carries a
# `shellcheck shell=bash` directive, and following sources from the dispatcher
# makes shellcheck walk the same libraries once per case arm — minutes of work
# for findings it already reports per file.
lint() {
  command -v shellcheck >/dev/null || {
    echo "shellcheck not installed — skipping (CI will run it)" >&2
    return 0
  }
  local f bad=0
  for f in "${SCRIPTS[@]}"; do
    shellcheck --severity=warning "$f" || bad=1
  done
  [[ $bad == 0 ]] && echo "shellcheck: ${#SCRIPTS[@]} scripts clean at warning severity"
  return $bad
}

# The whole deterministic half of the weekly report, on a fixture week. No
# GitHub token, no org, no model.
stats() {
  local out want got k
  out=$(jq -L lib -f lib/stats.jq test/fixtures/week.json)
  # The fixture week is four merged pull requests, two of them bots: one named
  # `dependabot`, one that is a bot only by its `[bot]` suffix. `merged` counts
  # the two people — it used to count all four — and `merged_without_review` is
  # one and not two because the bot release nobody reviewed is no longer in the
  # human figure. Both numbers changed meaning, not just value.
  for k in "merged=2" "merged_by_people=2" "merged_by_bots=2" "merged_total=4" \
    "merged_without_review=1" "repos_touched=2"; do
    want=${k#*=}
    got=$(jq -r ".${k%%=*}" <<<"$out")
    [[ $got == "$want" ]] || { echo "stats.jq: ${k%%=*} expected $want, got $got" >&2; return 1; }
  done
  echo "stats.jq: fixture week reads back correctly"

  local day
  day=$(jq -L lib -f lib/daily.jq test/fixtures/day.json)
  # merged and commits count people only; the bot rows are reported apart, and
  # a commit with no pull request behind it is the number the weekly recap
  # cannot see. `backport-bot` is in neither figure by name — the shared rule in
  # lib/bots.jq reads the `-bot` suffix, which the old hand-written list missed.
  for k in "merged=2" "merged_by_bots=1" "commits=2" "commits_outside_prs=1" \
    "commits_by_bots=2" "repos_touched=3" "authors=2" "merged_without_review=1"; do
    want=${k#*=}
    got=$(jq -r ".${k%%=*}" <<<"$day")
    [[ $got == "$want" ]] || { echo "daily.jq: ${k%%=*} expected $want, got $got" >&2; return 1; }
  done
  got=$(jq -r '.waiting[0].number' <<<"$day")
  [[ $got == 400 ]] || { echo "daily.jq: oldest unreviewed PR should lead, got $got" >&2; return 1; }
  echo "daily.jq: fixture day reads back correctly"
}

