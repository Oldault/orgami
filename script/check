# A clone is somebody else's tree, and a symlink in it can point anywhere on
# this machine. Fixture clones with links that escape: nothing outside the
# checkout is ever quoted into the map.
doc_safety() {
  ./test/doc_safety_test.sh </dev/null >/dev/null
  echo "doc-safety: escaping symlinks never quoted, the company name taken literally"
}

# The pull request cache is what every weekly figure is computed from, so a
# failed search must leave the previous week rather than an empty one. Stub gh.
pull_cache() {
  ./test/pull_cache_test.sh </dev/null >/dev/null
  echo "pull: every page cached, a failed search keeps the previous cache"
}

# The weekly run is unattended, so one failed step must be named and must not
# stop the rest, and a quiet week is not a failure. Stub steps.
weekly() {
  ./test/weekly_test.sh </dev/null >/dev/null
  echo "weekly: carries on past a failed step, names it, a quiet week is no recap"
}

# A timer runs with the init system's PATH, which has no ~/.local/bin — where
# orgami and claude both live. Every unit, plist and cron line has to set it.
schedule_path() {
  ./test/schedule_path_test.sh </dev/null >/dev/null
  echo "schedule-path: every timer form sets a PATH with ~/.local/bin"
}

# An error reply from the model is still text on stdout with exit 0, and must
# not be written as the recap. Stub claude and gh.
report_hardening() {
  ./test/report_hardening_test.sh </dev/null >/dev/null
  echo "report: stats-only without claude, error replies refused, quoted STATS keys rewritten, daily refetches a stale day"
}

# An agent or a script runs init with no terminal. With flags it must write the
# config without a prompt, bare it must die naming the flags, and every GitHub
# failure must say which one it is. Fake gh and gum, no network.
init_headless() {
  ./test/init_headless_test.sh </dev/null >/dev/null
  echo "init: flags without a prompt, bare dies naming them, each gh failure told apart"
}

# A scan's failures have to say which failure they are: a bad token, a
# missing repo, a broken clone. Exclude patterns are regexes, --jobs and
# --depth are checked, and one scan per company runs at a time. Stub gh.
scan_ops() {
  ./test/scan_ops_test.sh </dev/null >/dev/null
  echo "scan-ops: each gh failure told apart, globs refused, one scan at a time"
}

# fzf has changed its options across versions, and an option an old fzf does
# not know is a view that never opens. A fake fzf --version pins what each one
# is handed.
fzf_compat() {
  ./test/tui_fzf_compat_test.sh </dev/null >/dev/null
  echo "fzf: each version handed only options it knows, below the floor refused"
}

# graph.json is built from names and descriptions anybody with a repository
# can write. Rendered from a hostile one, nothing may survive as markup or a
# live URL.
page_hostile() {
  ./test/page_hostile_test.sh </dev/null >/dev/null
  echo "page-hostile: no injected markup or javascript: URL survives in either page"
}

# `orgami doctor --json` is what an agent reads to find out what is missing,
# and the session hooks run in every session, mapped or not. Stub gh, temp HOME.
doctor() {
  ./test/doctor_test.sh </dev/null >/dev/null
  echo "doctor: JSON pinned, exit 1 only on a blocker; hooks silent or one line"
}

# The SessionStart hook runs in every session, mapped or not: outside a mapped
# checkout it prints nothing, even with drafts and an update notice waiting.
hook() {
  ./test/hook_session_context_test.sh </dev/null >/dev/null
  echo "hook: silent outside a mapped checkout, brief and drafts inside one"
}

# bootstrap.sh runs as `curl | bash`, where stdin is the script itself. Under
# env -i with stub apt-get, sudo and curl: apt noninteractive with an empty
# stdin, gnupg before Charm's key, a failure named, an old jq warned about, and
# --ref holding a release with no branch to follow.
bootstrap() {
  ./test/bootstrap_test.sh </dev/null >/dev/null
  echo "bootstrap: apt noninteractive on an empty stdin, gnupg first, a failure named, --ref pins a release"
}

# uninstall edits files other tools own — crontab, Cursor's hooks.json and
# mcp.json — so what it must keep matters as much as what it removes. Temp HOME
# and stub systemctl, claude, crontab and gh.
uninstall() {
  ./test/uninstall_test.sh </dev/null >/dev/null
  echo "uninstall: everything installed removed, every shared file keeps its other entries"
}

# The MCP server is how any client other than Claude Code reads the map. Prints
# its own line, and skips itself where python3 is missing.
mcp() {
  ./test/mcp_server_test.sh </dev/null
}

# Debian 12 ships jq 1.6 and Ubuntu 24.04 1.7.1, and each refused programs the
# 1.8 on a developer's machine accepts. Runs the jq-heavy paths under each old
# jq it finds (JQ_COMPAT, or jq-1.6 and jq-1.7.1 on PATH); prints its own line,
# and skips itself with neither.
jq_compat() {
  ./test/jq_compat_test.sh </dev/null
}

# The check registry. One line per check: the flag that runs it on its own, and
# the function behind it. Bare `script/check` walks this list in order, so a new
# check is one self-contained line here plus its function above — nothing else
# to edit, and two branches each adding a check touch different lines instead of
# fighting over one.
CHECKS=(
  --syntax-only:syntax
  --lint-only:lint
  --stats:stats
  --profile:profile
  --workspace:workspace
  --detect:detect
  --vendors:vendors
  --vendors-precision:vendors_precision
  --deploy:deploy
  --advise:advise
  --cost:cost
  --dns:dns
  --dns-domains:dns_domains
  --live:live
  --live-error:live_error
  --depth:depth
  --coupling:coupling
  --scan-graph:scan_graph
  --update:update
  --publish:publish
  --notes:notes
  --notes-index:notes_index
  --secrets:secrets
  --docs-repo:docs_repo
  --prune:prune
  --decisions:decisions
  --drafts:drafts
  --autonote:autonote
  --tui:tui
  --style:style
  --agents:agents
  --agents-mcp:agents_mcp
  --playbook:playbook
  --runbook:runbook
  --linkify:linkify
  --schedule:schedule
  --flags:flags
  --help-flags:help_check
  --query:query
  --html:html
  --web:web
  --views:views
  --views-test:views_test
  --doc:doc
  --cards:cards
  --completions:completions
  --helpers:helpers
  --review-auto:review_auto
  --autosync:autosync
  --join:join_check
  --note-org:note_org
  --install-check:install_check
  --scan:scan_merge
  --doc-safety:doc_safety
  --pull:pull_cache
  --weekly:weekly
  --schedule-path:schedule_path
  --report:report_hardening
  --init:init_headless
  --scan-ops:scan_ops
  --fzf:fzf_compat
  --page-hostile:page_hostile
  --doctor:doctor
  --hook:hook
  --bootstrap:bootstrap
  --uninstall:uninstall
  --mcp:mcp
  --jq-compat:jq_compat
)

# Generated from the registry, four flags to a line, so the usage block cannot
# drift out of date with what the script actually runs.
usage() {
  local e flags=() line="" lines=() n=0 i prefix suffix
  for e in "${CHECKS[@]}"; do flags+=("${e%%:*}"); done
  for e in "${flags[@]}"; do
    line+="${line:+ | }$e"
    n=$((n + 1))
    if (( n % 4 == 0 )); then lines+=("$line"); line=""; fi
  done
  [[ -n $line ]] && lines+=("$line")
  for i in "${!lines[@]}"; do
    prefix="                     "
    suffix=" |"
    (( i == 0 )) && prefix="usage: script/check ["
    (( i == ${#lines[@]} - 1 )) && suffix="]"
    echo "$prefix${lines[i]}$suffix" >&2
  done
}

# Every check, in registry order, stopping at the first failure. The flags exist
# to re-run one of them on its own.
run_all() {
  local e
  for e in "${CHECKS[@]}"; do
    "${e#*:}" || return $?
  done
}

run_one() {
  local flag=$1 e
  for e in "${CHECKS[@]}"; do
    if [[ ${e%%:*} == "$flag" ]]; then
      "${e#*:}"
      return $?
    fi
  done
  usage
  exit 2
}

case ${1-} in
  "") run_all ;;
  *) run_one "$1" ;;
esac
