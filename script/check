#!/usr/bin/env bash
# Everything CI runs, runnable before you push. No arguments: both passes.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

SCRIPTS=(bin/orgami install.sh script/check)
while IFS= read -r f; do SCRIPTS+=("$f"); done < <(
  find lib hooks test -name '*.sh' -type f | sort
)

syntax() {
  local f bad=0
  for f in "${SCRIPTS[@]}"; do
    bash -n "$f" || { echo "syntax error: $f" >&2; bad=1; }
  done
  [[ $bad == 0 ]] && echo "bash -n: ${#SCRIPTS[@]} scripts ok"
  return $bad
}

# One file at a time, and without --external-sources: every lib carries a
# `shellcheck shell=bash` directive, and following sources from the dispatcher
# makes shellcheck walk the same libraries once per case arm — minutes of work
# for findings it already reports per file.
lint() {
  command -v shellcheck >/dev/null || {
    echo "shellcheck not installed — skipping (CI will run it)" >&2
    return 0
  }
  local f bad=0
  for f in "${SCRIPTS[@]}"; do
    shellcheck --severity=warning "$f" || bad=1
  done
  [[ $bad == 0 ]] && echo "shellcheck: ${#SCRIPTS[@]} scripts clean at warning severity"
  return $bad
}

# The whole deterministic half of the weekly report, on a fixture week. No
# GitHub token, no org, no model.
stats() {
  local out
  out=$(jq -f lib/stats.jq test/fixtures/week.json)
  local merged reviewless
  merged=$(jq -r .merged <<<"$out")
  reviewless=$(jq -r .merged_without_review <<<"$out")
  [[ $merged == 3 ]] || { echo "expected 3 merged, got $merged" >&2; return 1; }
  [[ $reviewless == 2 ]] || { echo "expected 2 unreviewed, got $reviewless" >&2; return 1; }
  echo "stats.jq: fixture week reads back correctly"

  local day
  day=$(jq -f lib/daily.jq test/fixtures/day.json)
  local want got k
  # merged and commits count people only; the bot rows are reported apart, and
  # a commit with no pull request behind it is the number the weekly recap
  # cannot see.
  for k in "merged=2" "merged_by_bots=1" "commits=2" "commits_outside_prs=1" \
    "commits_by_bots=1" "repos_touched=3" "authors=2" "merged_without_review=1"; do
    want=${k#*=}
    got=$(jq -r ".${k%%=*}" <<<"$day")
    [[ $got == "$want" ]] || { echo "daily.jq: ${k%%=*} expected $want, got $got" >&2; return 1; }
  done
  got=$(jq -r '.waiting[0].number' <<<"$day")
  [[ $got == 400 ]] || { echo "daily.jq: oldest unreviewed PR should lead, got $got" >&2; return 1; }
  echo "daily.jq: fixture day reads back correctly"
}

# profile_routes must keep test-file routes out of the endpoints list. The
# assertion script builds a fixture tree with one real route and several
# test-file routes and sources lib/profile.sh directly.
profile() {
  ./test/profile_routes_test.sh >/dev/null
  echo "profile_routes: test paths excluded from endpoints list"
}

# `profile_framework` and `profile_commands` are where every new detection
# branch lands, so what they already read off a checkout is pinned: one fixture
# tree per case, no clone, no network.
detect() {
  ./test/profile_detect_test.sh >/dev/null
  echo "detect: frameworks, scripts, package manager and runtime read off a tree"
}

# A vendor edge says an organization is paying somebody, so it may only exist
# where a committed file says so. Runs against three hand-written checkouts —
# no clone, no network, no token.
vendors() {
  ./test/vendors_match_test.sh >/dev/null
  echo "vendors: matched on committed evidence, near misses left alone"
}

# A deploy edge says an organization runs its software somewhere, so it may only
# exist where a committed file says so — and `app.json` means Dokku to one
# platform and Heroku to another. Runs against hand-written checkouts.
deploy() {
  ./test/scan_deploy_test.sh >/dev/null
  echo "deploy: each target found by its own file, lookalikes left alone"
}

advise() {
  ./test/advise_test.sh >/dev/null
  echo "advise: every proposal carries its file:line, and a rejection sticks"
}

# `orgami dns` reads public DNS, so the one thing this must never do is make a
# query. Runs the matcher against recorded `dig` output through a stub `dig`.
dns() {
  ./test/dns_match_test.sh >/dev/null
  echo "dns: records matched against the catalogue, near misses left alone"
}

# `orgami live` attributes a deployment to a repo only when the map or an exact
# name says so. Runs against a stub flyctl — no credentials, no network.
live() {
  ./test/live_match_test.sh >/dev/null
  echo "live: deployments matched only on evidence, and dated"
  ./test/live_aws_test.sh >/dev/null
  echo "live/aws: every resource enumerated, only named ones attributed"
}

# `orgami depth` may only call an edge extracted when the import resolves on its
# own. Runs against a hand-written depth.json — no tree-sitter, no checkouts.
depth() {
  ./test/depth_match_test.sh >/dev/null
  echo "depth: imports resolved to a repo only when the specifier says so"
  # The language table against real grammars, when they are installed. Skips
  # itself otherwise, and says so.
  ./test/depth_parse_test.sh
}

# `orgami update` runs unattended, so what matters is what it refuses. Runs
# against real git repositories in a temp directory — no network, no remote.
update() {
  ./test/update_test.sh >/dev/null
  echo "update: refuses dirty, diverged, untracked and the plugin clone"
}

# A note left in an unmerged pull request is a note nobody wrote. Runs against a
# stub gh and a stub git — no network, no repository, no push.
notes() {
  ./test/notes_merge_test.sh >/dev/null
  echo "notes: a protected branch queues, a moved base retries, anything else reports"
}

# A playbook's prose is written by a model, so the gathering under it has to be
# exact. Runs against hand-written notes and a hand-written pull request cache.
playbook() {
  ./test/playbook_test.sh >/dev/null
  echo "playbook: instances counted, one instance refused, the same job matched"
}

# `orgami query --json` is what anything built on the map reads, so its shape
# is pinned, and so is the confidence on every edge it hands out. Runs against a
# hand-written graph.json under a temp ORGAMI_HOME.
query() {
  ./test/query_json_test.sh >/dev/null
  echo "query: the node and both directions of its edges, evidence and confidence intact"
}

# map/graph.html must open with no network and say what graph.json says.
html() {
  ./test/html_render_test.sh >/dev/null
  echo "html: self-contained, and every edge keeps its confidence"
}

# The check registry. One line per check: the flag that runs it on its own, and
# the function behind it. Bare `script/check` walks this list in order, so a new
# check is one self-contained line here plus its function above — nothing else
# to edit, and two branches each adding a check touch different lines instead of
# fighting over one.
CHECKS=(
  --syntax-only:syntax
  --lint-only:lint
  --stats:stats
  --profile:profile
  --detect:detect
  --vendors:vendors
  --deploy:deploy
  --advise:advise
  --dns:dns
  --live:live
  --depth:depth
  --update:update
  --notes:notes
  --playbook:playbook
  --query:query
  --html:html
)

# Generated from the registry, four flags to a line, so the usage block cannot
# drift out of date with what the script actually runs.
usage() {
  local e flags=() line="" lines=() n=0 i prefix suffix
  for e in "${CHECKS[@]}"; do flags+=("${e%%:*}"); done
  for e in "${flags[@]}"; do
    line+="${line:+ | }$e"
    n=$((n + 1))
    if (( n % 4 == 0 )); then lines+=("$line"); line=""; fi
  done
  [[ -n $line ]] && lines+=("$line")
  for i in "${!lines[@]}"; do
    prefix="                     "
    suffix=" |"
    (( i == 0 )) && prefix="usage: script/check ["
    (( i == ${#lines[@]} - 1 )) && suffix="]"
    echo "$prefix${lines[i]}$suffix" >&2
  done
}

# Every check, in registry order, stopping at the first failure. The flags exist
# to re-run one of them on its own.
run_all() {
  local e
  for e in "${CHECKS[@]}"; do
    "${e#*:}" || return $?
  done
}

run_one() {
  local flag=$1 e
  for e in "${CHECKS[@]}"; do
    if [[ ${e%%:*} == "$flag" ]]; then
      "${e#*:}"
      return $?
    fi
  done
  usage
  exit 2
}

case ${1-} in
  "") run_all ;;
  *) run_one "$1" ;;
esac
