{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orgami",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./docs", "not_found_handling": "404-page", "html_handling": "auto-trailing-slash" },
  "routes": [
    { "pattern": "orgami.dev", "custom_domain": true },
    { "pattern": "www.orgami.dev", "custom_domain": true }
  ]
}
