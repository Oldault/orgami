[Unit]
Description=orgami weekly recap and map refresh
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=ORGAMI_COMPANY=%i
# The user manager's PATH has no ~/.local/bin, where orgami and claude live.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/orgami weekly
TimeoutStartSec=45min
