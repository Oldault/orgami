{
  "name": "orgami",
  "description": "Organization context for agents: what each repo is, how to run it, what it talks to, the team's conventions and decisions, and a shared note memory synced through git.",
  "version": "1.3.1",
  "author": {
    "name": "Antoine Chevalier",
    "url": "https://github.com/Oldault"
  },
  "homepage": "https://github.com/Oldault/orgami",
  "license": "MIT",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-context.sh\"",
            "timeout": 10,
            "statusMessage": "Loading organization context..."
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-note.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "icon": "./logo.png",
  "mcpServers": {
    "orgami": {
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/lib/mcp.py"
      ],
      "env": {
        "ORGAMI_BIN": "${CLAUDE_PLUGIN_ROOT}/bin/orgami"
      }
    }
  }
}
